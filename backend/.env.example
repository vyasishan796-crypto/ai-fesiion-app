# Django
SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# Database (SQLite for dev, PostgreSQL for prod)
# DATABASE_URL=postgresql://user:pass@localhost:5432/dbname

# CORS
CORS_ALLOW_ALL_ORIGINS=True

# JWT
JWT_ACCESS_TOKEN_LIFETIME_DAYS=7
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# ─── AI Virtual Try-On Configuration ───
# NVIDIA Flux API (get key from https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_API_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.2-klein-4b
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b

# Qwen2.5-VL via DashScope / NVIDIA Queen (get key from https://dashscope.aliyuncs.com or https://build.nvidia.com)
# This key is used for BOTH Virtual Try-On prompt enhancement AND Digital Wardrobe clothing analysis
# Set EITHER QWEN_VL_API_KEY or DASHSCOPE_API_KEY or NVIDIA_API_KEY — all are checked
QWEN_VL_API_KEY=your_nvidia_queen_api_key_here
DASHSCOPE_API_KEY=your_dashscope_api_key_here
QWEN_VL_API_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
QWEN_VL_MODEL=qwen2.5-vl-7b-instruct
NVIDIA_QWEN_URL=https://ai.api.nvidia.com/v1/chat/completions

# Optional: Pollinations (free fallback - no key needed)
# Pollinations is free and requires no API key

# Deprecated: GEMINI_API_KEY no longer used — wardrobe analyzer now uses NVIDIA Qwen